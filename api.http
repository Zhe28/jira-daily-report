@aiBaseUrl = http://192.168.3.7:8002/v1
@aiKey = ebiz
@aiModel = Qwen3.8-27B-FP8

POST {{aiBaseUrl}}/chat/completions
Content-Type: application/json
Authorization: Bearer {{aiKey}}

{
    "model": "{{aiModel}}",
    "messages": [
        { "role": "system", "content": "你是软件研发日报撰写助手。" },
        { "role": "user", "content": "请用一句话总结：今天修复了登录超时问题。" }
    ]
}
